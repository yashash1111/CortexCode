# ==============================================================================
# CortexCode Environment Configuration Template
# ==============================================================================

# AI PROVIDERS (Server-side ONLY. NEVER expose to frontend or git)
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=

# AI CONFIGURATION
AI_PROVIDER=auto
AI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=auto
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# DATABASE & REDIS
DATABASE_URL=postgresql://postgres:password@localhost:5432/devlens?schema=public
REDIS_URL=redis://localhost:6379

# AUTHENTICATION & INTERNAL SERVICE
JWT_SECRET=replace_with_strong_jwt_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_encryption_secret
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace_with_internal_service_token

# GITHUB
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/github/callback

# APPLICATION
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
