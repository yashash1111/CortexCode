# ==============================================================================
# CortexCode Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SERVICES (apps/api) - SERVER-SIDE ONLY SECRETS
# ------------------------------------------------------------------------------
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/devlens?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# AI Service Keys (Server-side ONLY. NEVER expose to frontend or git)
GEMINI_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=auto

# CORS & Client Origins
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# FRONTEND (apps/web) - PUBLIC CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Do NOT put Gemini secrets here. Only public backend URLs.
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
