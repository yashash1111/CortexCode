# Database & Queue (backend/api)
DATABASE_URL=postgresql://postgres:password@localhost:5432/devlens?schema=public
REDIS_URL=redis://localhost:6379

# Backend JWT & Crypto
JWT_SECRET=replace_with_secure_random_string
JWT_REFRESH_SECRET=replace_with_secure_random_string
ENCRYPTION_KEY=replace_with_32_byte_hex_or_random_string

# Centralized AI Providers (Backend Only — Never expose to Frontend)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

AI_DEFAULT_PROVIDER=gemini
AI_PROVIDER_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_USER_DAILY_REQUEST_LIMIT=250
AI_USER_MONTHLY_TOKEN_LIMIT=2000000

# GitHub OAuth & Webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/github/callback
GITHUB_WEBHOOK_SECRET=

# Service URLs
PORT=3001
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace_with_shared_internal_token
NEXT_PUBLIC_API_URL=http://localhost:3001
