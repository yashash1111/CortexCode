generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String   @id @default(uuid())
  name          String
  username      String?  @unique
  email         String   @unique
  emailVerified Boolean  @default(true)
  passwordHash  String?
  avatarUrl     String?
  developerRole String?
  bio           String?  @db.Text
  location      String?
  websiteUrl    String?
  githubUrl     String?
  linkedinUrl   String?
  skills        Json?
  preferences   Json?
  role          String   @default("USER") // USER | ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  githubAccount  GitHubAccount?
  refreshTokens  RefreshToken[]
  repositories   Repository[]
  activityLogs   ActivityLog[]
  conversations  Conversation[]
  aiAnalyses     AIAnalysis[]
  aiUsages       AIUsage[]
  documentations Documentation[]
  teamMembers    TeamMember[]
  comments       Comment[]
  notifications  Notification[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  assessmentSessions AssessmentSession[]
  workspaces         Workspace[]
  documents          Document[]
  ingestionJobs      IngestionJob[]
  usageLogs              UsageLog[]
  evalRuns               EvalRun[]
  mockInterviewSessions  MockInterviewSession[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GitHubAccount {
  id                   String   @id @default(uuid())
  userId               String   @unique
  githubUserId         String   @unique
  username             String
  accessTokenEncrypted String
  avatarUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  repositories TeamRepository[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   // Owner, Admin, Member, Viewer
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamRepository {
  id           String   @id @default(uuid())
  teamId       String
  repositoryId String
  createdAt    DateTime @default(now())

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([teamId, repositoryId])
}

model Repository {
  id             String    @id @default(uuid())
  userId         String
  workspaceId    String?
  githubId       String    @unique
  name           String
  fullName       String
  description    String?
  owner          String
  defaultBranch  String
  private        Boolean
  language       String?
  stars          Int       @default(0)
  forks          Int       @default(0)
  githubUrl      String
  lastAnalyzedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  files          RepositoryFile[]
  activityLogs   ActivityLog[]
  codeChunks     CodeChunk[]
  conversations  Conversation[]
  aiAnalyses     AIAnalysis[]
  aiUsages       AIUsage[]
  documentations Documentation[]
  jobs           Job[]
  teamMappings   TeamRepository[]
  pullRequests   PullRequest[]
  securityFindings SecurityFinding[]
  dependencyFindings DependencyFinding[]
  comments       Comment[]
  webhookEvents  WebhookEvent[]
  auditLogs      AuditLog[]
  notes          RepositoryNote[]
  memories       Memory[]
  graphEdges     CodeGraphEdge[]
}

model RepositoryFile {
  id           String   @id @default(uuid())
  repositoryId String
  path         String
  name         String
  extension    String?
  language     String?
  size         Int
  lineCount    Int?
  content      String?  @db.Text
  contentHash  String?
  imports      Json?
  symbols      Json?
  isBinary     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([path])
  @@index([language])
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model CodeChunk {
  id           String   @id @default(uuid())
  repositoryId String
  fileId       String
  content      String   @db.Text
  filePath     String
  language     String?
  symbolName   String?
  startLine    Int?
  endLine      Int?
  chunkIndex   Int
  tokenCount   Int
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([fileId])
}

model Conversation {
  id           String   @id @default(uuid())
  repositoryId String?
  workspaceId  String?
  moduleType   String   @default("workspace") // "workspace" | "repo" | "doc"
  userId       String
  title        String   @default("New Conversation")
  model        String   @default("CortexCode AI (GPT-4o)")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  workspace  Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([workspaceId, moduleType])
  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String   @db.Text
  mode           String   @default("chat")
  provider       String?
  model          String?
  sources        Json?
  attachments    Json?
  feedback       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIAnalysis {
  id           String   @id @default(uuid())
  repositoryId String
  userId       String
  type         String
  targetFileId String?
  result       Json
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIUsage {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String?
  requestType  String
  inputTokens  Int
  outputTokens Int
  estimatedCost Float
  model        String
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Documentation {
  id           String   @id @default(uuid())
  repositoryId String
  type         String
  title        String
  content      String   @db.Text
  version      String
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model Job {
  id           String    @id @default(uuid())
  repositoryId String
  type         String
  status       String
  progress     Int       @default(0)
  total        Int       @default(0)
  processed    Int       @default(0)
  error        String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model PullRequest {
  id           String   @id @default(uuid())
  repositoryId String
  githubId     String
  number       Int
  title        String
  description  String?  @db.Text
  author       String
  sourceBranch String
  targetBranch String
  status       String
  githubUrl    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews    PullRequestReview[]
}

model PullRequestReview {
  id            String    @id @default(uuid())
  pullRequestId String
  workspaceId   String?
  prUrl         String?
  status        String
  summary       String?   @db.Text
  diffContent   String?   @db.Text
  changedFiles  Json?
  score         Int?
  model         String?
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  pullRequest PullRequest     @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  findings    ReviewFinding[]
}

model ReviewFinding {
  id             String   @id @default(uuid())
  reviewId       String
  filePath       String
  lineNumber     Int?
  startLine      Int?
  endLine        Int?
  severity       String
  category       String
  title          String
  description    String   @db.Text
  recommendation String?  @db.Text
  suggestedFix   String?  @db.Text
  status         String   @default("open") // open, dismissed, resolved, approved
  confidence     Float?

  review PullRequestReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model SecurityFinding {
  id             String   @id @default(uuid())
  repositoryId   String
  fileId         String?
  category       String
  severity       String
  title          String
  description    String   @db.Text
  startLine      Int?
  endLine        Int?
  evidence       String?  @db.Text
  recommendation String?  @db.Text
  status         String
  confidence     Float?
  createdAt      DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model DependencyFinding {
  id             String   @id @default(uuid())
  repositoryId   String
  name           String
  version        String
  type           String
  risk           String
  vulnerabilities Json?
  createdAt      DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model Comment {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  targetType   String
  targetId     String
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id               String   @id @default(uuid())
  githubDeliveryId String   @unique
  eventType        String
  repositoryId     String?
  payloadHash      String
  status           String
  receivedAt       DateTime @default(now())
  processedAt      DateTime?

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  targetType   String?
  targetId     String?
  repositoryId String?
  metadata     Json?
  timestamp    DateTime @default(now())

  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryNote {
  id           String   @id @default(uuid())
  repositoryId String
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model Memory {
  id           String   @id @default(uuid())
  repositoryId String
  key          String
  value        String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@unique([repositoryId, key])
}

model SecurityEvent {
  id              String   @id @default(uuid())
  userId          String
  type            String   // LOGIN, PASSWORD_CHANGED, PASSWORD_RESET, LOGOUT, FAILED_LOGIN, NEW_DEVICE
  ipAddress       String?
  userAgent       String?  @db.Text
  device          String?
  browser         String?
  operatingSystem String?
  location        String?  @default("Unavailable")
  success         Boolean  @default(true)
  timestamp       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Assessment {
  id                   String   @id @default(uuid())
  title                String
  description          String?  @db.Text
  durationMinutes      Int      @default(60)
  difficulty           String   @default("Intermediate")
  status               String   @default("PUBLISHED") // DRAFT, PUBLISHED, ACTIVE, COMPLETED, ARCHIVED
  subjects             Json
  questionTypes        Json
  sections             Json?
  scoringPolicy        Json?
  canNavigateBackwards Boolean  @default(true)
  totalPoints          Int      @default(100)
  proctorConfig        Json?
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  questions AssessmentQuestion[]
  sessions  AssessmentSession[]
}

model AssessmentQuestion {
  id                 String   @id @default(uuid())
  assessmentId       String
  sectionId          String?
  type               String   // MCQ, CODING, SUBJECTIVE, COMPREHENSION
  prompt             String   @db.Text
  subject            String?
  topic              String?
  difficulty         String   @default("Intermediate")
  options            Json?
  correctAnswer      String?
  multipleCorrect    Boolean  @default(false)
  explanation        String?  @db.Text
  starterCode        Json?
  constraints        Json?
  examples           Json?
  supportedLanguages Json?
  testCases          Json?
  hiddenTests        Json?
  timeLimit          Int      @default(2000)
  memoryLimit        Int      @default(256)
  expectedConcepts   Json?
  rubric             String?  @db.Text
  passage            String?  @db.Text
  points             Int      @default(10)
  order              Int      @default(0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@index([assessmentId])
}

model QuestionBankItem {
  id                 String   @id @default(uuid())
  type               String   // MCQ, CODING, SUBJECTIVE, COMPREHENSION
  prompt             String   @db.Text
  subject            String
  topic              String?
  difficulty         String   @default("Intermediate")
  points             Int      @default(10)
  options            Json?
  correctAnswer      String?
  multipleCorrect    Boolean  @default(false)
  explanation        String?  @db.Text
  starterCode        Json?
  constraints        Json?
  examples           Json?
  supportedLanguages Json?
  testCases          Json?
  hiddenTests        Json?
  timeLimit          Int      @default(2000)
  memoryLimit        Int      @default(256)
  expectedConcepts   Json?
  rubric             String?  @db.Text
  passage            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([subject])
  @@index([difficulty])
  @@index([type])
}

model AssessmentSession {
  id                   String    @id @default(uuid())
  userId               String
  assessmentId         String
  status               String    @default("ACTIVE") // ACTIVE, SUBMITTED, EXPIRED, TERMINATED
  startedAt            DateTime?
  expiresAt            DateTime?
  submittedAt          DateTime?
  currentQuestionIndex Int       @default(0)
  currentQuestionId    String?
  currentSectionId     String?
  fullscreenExitCount  Int       @default(0)
  tabSwitchCount       Int       @default(0)
  proctoringStatus     String    @default("ACTIVE")
  terminationReason    String?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]
  events     ProctorEvent[]
  result     AssessmentResult?

  @@index([userId])
  @@index([assessmentId])
}

model AssessmentAnswer {
  id                String   @id @default(uuid())
  sessionId         String
  questionId        String
  selectedOption    String?
  selectedOptions   Json?
  subjectiveAnswer  String?  @db.Text
  codeAnswer        String?  @db.Text
  codeLanguage      String?
  pointsAwarded     Float?
  aiFeedback        Json?
  timeSpentSeconds  Int      @default(0)
  isMarkedForReview Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  session  AssessmentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model ProctorEvent {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String
  assessmentId String
  type         String
  severity     String   @default("INFO")
  metadata     Json?
  timestamp    DateTime @default(now())

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AssessmentResult {
  id                        String    @id @default(uuid())
  sessionId                 String    @unique
  userId                    String
  assessmentId              String
  assessmentTitle           String?
  overallScore              Float
  totalMarks                Float     @default(100)
  obtainedMarks             Float     @default(0)
  mcqScore                  Float
  codingScore               Float
  subjectiveScore           Float
  comprehensionScore        Float
  sectionScores             Json?
  questionScores            Json?
  subjectBreakdown          Json?
  codingResults             Json?
  subjectiveEvaluations     Json?
  comprehensionEvaluations  Json?
  topicAnalysis             Json?
  knowledgeGaps             Json?
  recommendations           Json?
  learningPath              Json?
  integritySummary          Json?
  strengths                 Json
  weaknesses                Json
  aiReport                  String    @db.Text
  proctoringSummary         Json?
  auditTrail                Json?
  humanReviews              Json?
  evaluationStatus          String    @default("COMPLETED") // NOT_STARTED, PROCESSING, PARTIALLY_COMPLETED, COMPLETED, FAILED
  evaluatorVersion          String    @default("v3.0.0")
  evaluatedAt               DateTime? @default(now())
  status                    String    @default("COMPLETED") // PROCESSING, COMPLETED, FAILED
  submittedAt               DateTime  @default(now())
  createdAt                 DateTime  @default(now())

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}


// ============================================================================
// CORTEXCODE PHASE 1 UNIFIED DATA ARCHITECTURE
// ============================================================================

model Workspace {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?  @db.Text
  slug        String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          Document[]
  repositories       Repository[]
  ingestionJobs      IngestionJob[]
  knowledgeChunks    KnowledgeChunk[]
  pullRequestReviews PullRequestReview[]
  evalRuns           EvalRun[]
  usageLogs          UsageLog[]
  conversations      Conversation[]

  @@index([userId])
}

model Document {
  id            String    @id @default(uuid())
  workspaceId   String
  userId        String
  title         String
  fileName      String
  mimeType      String
  size          Int
  sourcePath    String
  content       String?   @db.Text
  checksum      String?
  status        String    @default("PENDING") // PENDING, PROCESSING, INDEXED, FAILED
  chunkCount    Int       @default(0)
  lastIndexedAt DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model IngestionJob {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  moduleType  String    // "doc" | "repo"
  sourceId    String?
  bullJobId   String?
  dedupeKey   String?
  status      String    @default("queued") // queued, processing, completed, failed
  progress    Int       @default(0)
  total       Int       @default(0)
  processed   Int       @default(0)
  attempts    Int       @default(0)
  error       String?   @db.Text
  metadata    Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeChunks KnowledgeChunk[]

  @@index([workspaceId, status])
  @@index([dedupeKey, status])
  @@index([userId])
}

model KnowledgeChunk {
  id          String                       @id @default(uuid())
  workspaceId String
  jobId       String
  moduleType  String                       // "doc" | "repo"
  sourcePath  String
  metadata    Json?
  content     String                       @db.Text
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId, moduleType])
  @@index([jobId])
  @@index([sourcePath])
}

model EvalRun {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  moduleType  String    // "doc" | "repo" | "pr"
  name        String
  status      String    @default("queued") // queued, running, completed, failed
  metrics     Json?
  datasetSize Int       @default(0)
  passedCount Int       @default(0)
  error       String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases     EvalCaseResult[]

  @@index([workspaceId])
  @@index([userId])
}

model EvalCaseResult {
  id                 String   @id @default(uuid())
  evalRunId          String
  question           String   @db.Text
  expectedSource     String
  groundTruth        String   @db.Text
  actualAnswer       String   @db.Text
  retrievedSources   Json
  hitRate            Float    @default(0)
  reciprocalRank     Float    @default(0)
  contextRelevance   Float    @default(0)
  answerFaithfulness Float    @default(0)
  citationPrecision  Float    @default(0)
  latencyMs          Int      @default(0)
  reasoning          String?  @db.Text
  createdAt          DateTime @default(now())

  evalRun EvalRun @relation(fields: [evalRunId], references: [id], onDelete: Cascade)

  @@index([evalRunId])
}

model UsageLog {
  id            String   @id @default(uuid())
  userId        String?
  workspaceId   String?
  provider      String
  model         String
  requestType   String   // chat, stream, json, embed, pr_review
  latencyMs     Int
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  estimatedCost Float    @default(0)
  status        String   @default("success") // success, error
  errorMessage  String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}


model CodeGraphEdge {
  id           String   @id @default(uuid())
  repositoryId String
  workspaceId  String?
  sourceFile   String
  sourceSymbol String?
  targetFile   String
  targetSymbol String?
  edgeType     String   // import, call, route, model
  metadata     Json?
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([workspaceId])
  @@index([sourceFile])
}

model AIProviderConfig {
  id                String   @id @default(uuid())
  provider          String   @unique // gemini | groq | openrouter | cloudflare
  enabled           Boolean  @default(true)
  priority          Int      @default(1)
  selectedModel     String?
  dailyRequestLimit Int?
  monthlyTokenLimit Int?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AIProviderHealthEvent {
  id           String   @id @default(uuid())
  provider     String
  model        String?
  status       String   // healthy | degraded | rate_limited | auth_error | unavailable
  latencyMs    Int?
  statusCode   Int?
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
}

model MockInterviewSession {
  id                  String    @id @default(uuid())
  userId              String
  title               String?
  role                String
  experienceLevel     String
  difficulty          String
  currentDifficulty   String?
  interviewType       String
  preferredLanguage   String?
  durationMinutes     Int       @default(30)
  questionLimit       Int       @default(10)
  questionsAsked      Int       @default(0)
  currentTopic        String?
  skills              Json?
  jobDescription      String?   @db.Text
  projectInfo         String?   @db.Text
  topics              Json?
  status              String    @default("created") // created | in_progress | paused | completed
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    MockInterviewMessage[]
  evaluations MockInterviewEvaluation[]
  report      MockInterviewReport?

  @@index([userId, createdAt])
  @@index([status])
}

model MockInterviewMessage {
  id             String   @id @default(uuid())
  sessionId      String
  role           String   // interviewer | candidate | system
  content        String   @db.Text
  questionNumber Int?
  topic          String?
  metadata       Json?
  createdAt      DateTime @default(now())

  session MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model MockInterviewEvaluation {
  id                  String   @id @default(uuid())
  sessionId           String
  messageId           String?
  questionNumber      Int?
  correctnessScore    Float
  communicationScore  Float
  problemSolvingScore Float
  completenessScore   Float
  feedback            String   @db.Text
  strengths           Json?
  weaknesses          Json?
  createdAt           DateTime @default(now())

  session MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model MockInterviewReport {
  id                   String   @id @default(uuid())
  sessionId            String   @unique
  overallScore         Float
  technicalScore       Float?
  communicationScore   Float?
  problemSolvingScore  Float?
  summary              String   @db.Text
  strengths            Json
  weaknesses           Json
  recommendations      Json
  learningRoadmap      Json
  detailedResults      Json
  createdAt            DateTime @default(now())

  session MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
